# Conclave Environment Variables Template

# Google Cloud / Vertex AI Settings
SPRING_AI_VERTEX_AI_GEMINI_PROJECT_ID=your-gcp-project-id
SPRING_AI_VERTEX_AI_GEMINI_LOCATION=us-central1
# If using direct API key injection or standard OAuth credentials:
SPRING_AI_VERTEX_AI_GEMINI_API_KEY=your-gemini-api-key
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/gcp-credentials.json
